<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PulseEightControl</RootNamespace>
    <AssemblyName>PulseEightControl</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The icon of the .exe: Explorer, the taskbar, shortcuts and the installer's entries. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged and self-contained: runs from a folder with no installer or Windows App Runtime. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <DefaultLanguage>en-GB</DefaultLanguage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'ARM64'">
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- The version comes from the release tag and nowhere else (scripts/release/version.py; the release workflow passes
       -p:P8Version=<what people see> -p:P8Build=<what the update feed compares> -p:P8Channel -p:P8Label). The defaults are a
       development build's (version.py dev); test_version.py checks they match. `Version`, which becomes the assembly's file and
       informational version, is the build: it is what the updater reads as the installed version.
       The feed address and public key are compiled in only for release builds (-p:P8UpdateBaseUrl=... -p:P8UpdatePublicKey=...);
       without them the app never looks for updates. -->
  <PropertyGroup>
    <P8Version Condition="'$(P8Version)' == ''">0.0.0-dev</P8Version>
    <P8Build Condition="'$(P8Build)' == ''">0.0.0.0</P8Build>
    <P8Channel Condition="'$(P8Channel)' == ''">dev</P8Channel>
    <P8Label Condition="'$(P8Label)' == ''">Development build</P8Label>
    <Version>$(P8Build)</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="ReleaseVersion" Value="$(P8Version)" />
    <AssemblyMetadata Include="ReleaseBuild" Value="$(P8Build)" />
    <AssemblyMetadata Include="ReleaseChannel" Value="$(P8Channel)" />
    <AssemblyMetadata Include="ReleaseLabel" Value="$(P8Label)" />
  </ItemGroup>
  <ItemGroup Condition="'$(P8UpdateBaseUrl)' != '' And '$(P8UpdatePublicKey)' != ''">
    <AssemblyMetadata Include="UpdateBaseUrl" Value="$(P8UpdateBaseUrl)" />
    <AssemblyMetadata Include="UpdatePublicKey" Value="$(P8UpdatePublicKey)" />
  </ItemGroup>

  <!-- The logo and the icon, beside the .exe at run time (the window, the title bar and the About page load them from
       there). The app is unpackaged, so nothing else would put them in the output folder or the installer. -->
  <ItemGroup>
    <Content Include="Assets\Logo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
  </ItemGroup>

  <!-- pulseeight_core.dll and the Swift runtime DLLs it needs, staged by PulseEightControl-windows/build.ps1. -->
  <PropertyGroup>
    <P8NativeDir Condition="'$(P8NativeDir)' == ''">$(MSBuildThisFileDirectory)..\..\out\native\$(Platform)</P8NativeDir>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(P8NativeDir)')">
    <None Include="$(P8NativeDir)\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\PulseEight.Core.csproj" />
    <ProjectReference Include="..\Updates\PulseEight.Updates.csproj" />
  </ItemGroup>

</Project>
