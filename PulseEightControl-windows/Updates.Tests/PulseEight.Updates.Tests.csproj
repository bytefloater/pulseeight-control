<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- An independent Ed25519 (libsodium) to sign test feeds with, so the signer and NetSparkle's verifier
         aren't the same code agreeing with itself. -->
    <PackageReference Include="NSec.Cryptography" Version="25.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Updates\PulseEight.Updates.csproj" />
  </ItemGroup>

  <!-- A public key and a signature made by scripts/release/ed25519.swift (the signer releases use), to check that what
       it produces is what NetSparkle accepts. The private key was thrown away. -->
  <ItemGroup>
    <None Include="Fixtures\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
