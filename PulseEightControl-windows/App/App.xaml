<Application
    x:Class="PulseEightControl.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The only XAML in the app: the compiler turns it into the entry point, the resource index and
         the type metadata WinUI needs to load its control styles. Everything else is built in code. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- The title bar's back button gets no fill while disabled (just a dimmed arrow); hovering and pressing
                 it when enabled still show their usual fill. -->
            <SolidColorBrush x:Key="TitleBarBackButtonBackgroundDisabled" Color="Transparent" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
