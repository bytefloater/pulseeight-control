<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PulseEightControl</RootNamespace>
    <AssemblyName>PulseEightControl</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged and self-contained: runs from a folder with no installer or Windows App Runtime. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <DefaultLanguage>en-GB</DefaultLanguage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'ARM64'">
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- The version the update feed is compared against, as <VERSION>.<build> (the release workflow passes
       -p:P8Version=...). The feed address and public key are compiled in only for release builds
       (-p:P8UpdateBaseUrl=... -p:P8UpdatePublicKey=...); without them the app never looks for updates. -->
  <PropertyGroup>
    <P8Version Condition="'$(P8Version)' == ''">0.1.0.0</P8Version>
    <Version>$(P8Version)</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(P8UpdateBaseUrl)' != '' And '$(P8UpdatePublicKey)' != ''">
    <AssemblyMetadata Include="UpdateBaseUrl" Value="$(P8UpdateBaseUrl)" />
    <AssemblyMetadata Include="UpdatePublicKey" Value="$(P8UpdatePublicKey)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
  </ItemGroup>

  <!-- pulseeight_core.dll and the Swift runtime DLLs it needs, staged by PulseEightControl-windows/build.ps1. -->
  <PropertyGroup>
    <P8NativeDir Condition="'$(P8NativeDir)' == ''">$(MSBuildThisFileDirectory)..\..\out\native\$(Platform)</P8NativeDir>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(P8NativeDir)')">
    <None Include="$(P8NativeDir)\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\PulseEight.Core.csproj" />
    <ProjectReference Include="..\Updates\PulseEight.Updates.csproj" />
  </ItemGroup>

</Project>
